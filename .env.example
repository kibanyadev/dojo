# Fixed local test values. Copy to .env to run `docker compose up` directly;
# the Makefile targets read this file as is.
POSTGRES_PASSWORD=dojo-local-only
# Passwords of the dojo_api and dojo_admin database roles (set by the db-roles job).
DOJO_API_DB_PASSWORD=dojo-api-local-only
DOJO_ADMIN_DB_PASSWORD=dojo-admin-local-only

# Object store (the S3 stand-in, internal/storage). Root credentials of the container, also used by the API.
DOJO_S3_ACCESS_KEY=dojo-local
DOJO_S3_SECRET_KEY=dojo-local-only-secret
# Defaults live in compose.yaml. The public endpoint is what presigned URLs carry: the address the host reaches
# the published port on (DOJO_S3_PORT, default 9000). Change both together when you move the port.
# DOJO_S3_PORT=9000
# DOJO_S3_PUBLIC_ENDPOINT=http://localhost:9000
# DOJO_S3_REGION=us-east-1
# DOJO_S3_BUCKET=dojo-catalog

# Host port for the API. Leave unset for a random free one (`docker compose port api 8080`).
# API_PORT=8081

# Public origin of the site; the web build reads it (canonical link) and the API sets cookie Secure from it.
PUBLIC_ORIGIN=http://localhost:8080
# Web sign-in: the GitHub OAuth App, and the key that signs the state cookie (32+ bytes; the value below is public, local only).
# The defaults in compose.yaml point at the fake GitHub. GITHUB_AUTHORIZE_URL is what the browser opens.
# DOJO_-prefixed here because GitHub Actions exports its own GITHUB_API_URL, which compose would pick up.
# DOJO_GITHUB_CLIENT_ID=dojo-web-local
# DOJO_GITHUB_CLIENT_SECRET=web-local-only
# DOJO_GITHUB_AUTHORIZE_URL=http://localhost:8081
# DOJO_GITHUB_OAUTH_URL=http://fake-github:8081
# DOJO_GITHUB_API_URL=http://fake-github:8081
# Operator sign-in (dojo-admin): its own OAuth App, same pattern, DOJO_ADMIN_ prefix. Defaults point at the fake's dojo-admin-local client.
# DOJO_ADMIN_GITHUB_CLIENT_ID=dojo-admin-local
# DOJO_ADMIN_GITHUB_CLIENT_SECRET=admin-local-only
# DOJO_ADMIN_GITHUB_AUTHORIZE_URL=http://localhost:8081
# DOJO_ADMIN_GITHUB_OAUTH_URL=http://fake-github:8081
# DOJO_ADMIN_GITHUB_API_URL=http://fake-github:8081
# Version of the terms a new learner accepts; stored on the learner (1-32 of a-z 0-9 . -). Required, no default.
TERMS_VERSION=2026-11-20
AUTH_STATE_KEY=local-dev-state-key-not-a-secret-0123456789
# Host port for the edge (Caddy). Unset = 8080.
# EDGE_PORT=8080
# Host port for the fake GitHub (the browser lands on its authorize page). Unset = 8081.
# FAKE_GITHUB_PORT=8081
# Fake GitHub OAuth clients, id:secret:redirect_uri|redirect_uri;... (defaults live in compose.yaml).
# FAKE_GITHUB_CLIENTS=
# Clients with the device flow enabled (default dojo-web-local) and its poll interval in seconds (default 5).
# FAKE_GITHUB_DEVICE_CLIENTS=dojo-web-local
# FAKE_GITHUB_DEVICE_INTERVAL=5
# Unauthenticated reads per remote address per hour before the fake answers 403 (0 = no limit).
# FAKE_GITHUB_RATE_LIMIT=0
# Pass-commit verification (design 3.9). The read token has no scopes and is optional locally; the tick and
# batch are the API's defaults.
# DOJO_GITHUB_READ_TOKEN=
# DOJO_COMMIT_VERIFY_INTERVAL_SECONDS=60
# DOJO_COMMIT_VERIFY_BATCH=20
# Address the browser uses for the fake, shown as verification_uri (default: the request's Host).
# FAKE_GITHUB_PUBLIC_URL=

# Host port for the fake Web Push service (tests read what arrived). Unset = 8082.
# FAKE_PUSH_PORT=8082

# Written-work reviews (design 3.10): the adapter (standin until bedrock arrives), the tick and the batch.
# DOJO_AI_ADAPTER=standin
# DOJO_REVIEW_INTERVAL_SECONDS=10
# DOJO_REVIEW_BATCH=5 (1 to 5: calls run one after another under a 5 minute lease)

# How long the API caches the ai_reviews_enabled flag, in seconds (0 to 300, default 30; 0 turns the cache off).
# DOJO_FLAG_CACHE_SECONDS=30
